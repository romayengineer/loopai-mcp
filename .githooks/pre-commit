#!/bin/sh
set -e

echo "--- gofmt -s ---"
unformatted=$(gofmt -s -l .)
if [ -n "$unformatted" ]; then
	echo "Unformatted files:"
	echo "$unformatted"
	exit 1
fi

echo "--- go vet ---"
go vet ./internal/... ./cmd/...

echo "--- unit tests ---"
go test ./internal/... -count=1 -timeout 30s

echo "--- OK ---"
